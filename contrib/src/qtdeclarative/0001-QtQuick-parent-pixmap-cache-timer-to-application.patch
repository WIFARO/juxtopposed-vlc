From: VLC developers <vlc-devel@videolan.org>
Subject: [PATCH] QtQuick: parent the pixmap cache timer to the application

VLC creates its QApplication on a dedicated interface thread. The pixmap
cache has a cleanup timer on that thread, but its function-local static
instance is destroyed on the process entry thread after QApplication and
the interface thread have exited. QObject then tries to stop the timer
from the wrong thread.

Keep the existing cache lifetime, since application-owned QML objects can
still hold pixmaps while QApplication's QObject children are being deleted.
Instead give its expiry timer to QApplication and keep only a guarded
pointer in the cache. The timer is stopped and destroyed on its own thread,
and a later application gets a new timer. Use the timer as the connection
context since the process-wide cache can outlive its original GUI thread.

https://github.com/dsojevic/juxtopposed-vlc/issues/26
---
--- a/src/quick/util/qquickpixmapcache.cpp
+++ b/src/quick/util/qquickpixmapcache.cpp
@@ -21,6 +21,7 @@
 
 #include <QtCore/private/qobject_p.h>
 #include <QtCore/qcoreapplication.h>
+#include <QtCore/qtimer.h>
 #include <QtCore/qhash.h>
 #include <QtCore/qfile.h>
 #include <QtCore/qthread.h>
@@ -1245,10 +1246,10 @@
 
     m_destroying = true;
 
-    // Prevent unreferencePixmap() from assuming it needs to kick
-    // off the cache expiry timer, as we're shrinking the cache
-    // manually below after releasing all the pixmaps.
-    m_timerId = -2;
+    // Expiry is unnecessary while we manually empty the cache.
+    // m_destroying prevents unreferencePixmap() from restarting it.
+    if (m_timer)
+        m_timer->stop();
 
     // unreference all (leaked) pixmaps
     int leakedPixmaps = 0;
@@ -1313,9 +1314,15 @@
 
     shrinkCache(-1); // Shrink the cache in case it has become larger than cache_limit
 
-    if (m_timerId == -1 && m_unreferencedPixmaps
+    if ((!m_timer || !m_timer->isActive()) && m_unreferencedPixmaps
             && !m_destroying && !QCoreApplication::closingDown()) {
-        m_timerId = startTimer(CACHE_EXPIRE_TIME * 1000);
+        if (!m_timer) {
+            // The application owns the timer so it stops on the GUI thread,
+            // even when this process-wide cache is destroyed on another thread.
+            m_timer = new QTimer(QCoreApplication::instance());
+            connect(m_timer.data(), &QTimer::timeout, m_timer.data(), [this] { expireCache(); });
+        }
+        m_timer->start(CACHE_EXPIRE_TIME * 1000);
     }
 }
 
@@ -1368,15 +1375,14 @@
     }
 }
 
-void QQuickPixmapCache::timerEvent(QTimerEvent *)
+void QQuickPixmapCache::expireCache()
 {
     int removalCost = m_unreferencedCost / CACHE_REMOVAL_FRACTION;
 
     shrinkCache(removalCost);
 
     if (m_unreferencedPixmaps == nullptr) {
-        killTimer(m_timerId);
-        m_timerId = -1;
+        m_timer->stop();
     }
 }
 
--- a/src/quick/util/qquickpixmapcache_p.h
+++ b/src/quick/util/qquickpixmapcache_p.h
@@ -16,6 +16,7 @@
 //
 
 #include <QtCore/qmutex.h>
+#include <QtCore/qpointer.h>
 #include <QtCore/qurl.h>
 #include <QtQuick/qquickimageprovider.h>
 #include <private/qquickpixmap_p.h>
@@ -23,6 +24,7 @@
 QT_BEGIN_NAMESPACE
 
 class QQuickPixmapData;
+class QTimer;
 
 /*! \internal
     A composite key to identify a QQuickPixmapData instance in a QHash.
@@ -54,14 +56,12 @@
 
     void purgeCache();
 
-protected:
-    void timerEvent(QTimerEvent *) override;
-
 private:
     QQuickPixmapCache() = default;
     Q_DISABLE_COPY(QQuickPixmapCache)
 
     void shrinkCache(int remove);
+    void expireCache();
     int destroyCache();
     qsizetype referencedCost() const;
 
@@ -73,7 +73,7 @@
     QQuickPixmapData *m_lastUnreferencedPixmap = nullptr;
 
     int m_unreferencedCost = 0;
-    int m_timerId = -1;
+    QPointer<QTimer> m_timer;
     bool m_destroying = false;
 
     friend class QQuickPixmap;
